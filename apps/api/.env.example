# API Configuration
API_TITLE="SkyLaneAI API"
API_VERSION="2.0.0"
API_DESCRIPTION="Sky Hazard Detection API for Flying Taxis"

# CORS Settings
CORS_ORIGINS=["http://localhost:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png", ".mp4", ".avi"]

# Model Settings
MODELS_DIR="models"  # Directory to cache downloaded models
MODEL_NAME="yolo11n.pt"  # YOLO model to use (yolo11n.pt, yolo11s.pt, yolo11m.pt, etc.)
MODEL_CACHE_ENABLED=true  # Cache models locally to avoid re-downloading
CONFIDENCE_THRESHOLD=0.25  # Minimum confidence for detections (0.0-1.0)
IOU_THRESHOLD=0.45  # Intersection over Union threshold for NMS

# Sky Hazard Detection Settings
# Only detect these classes (sky hazards). Set to empty list [] to detect all classes.
# COCO dataset classes that might appear in sky: bird, kite, airplane
# Note: COCO doesn't have "drone" or "balloon" as separate classes, but:
# - Drones may be detected as "airplane" or "kite"
# - Balloons may be detected as "kite" or "sports ball"
SKY_HAZARD_CLASSES=["bird", "kite", "airplane", "sports ball"]

# Video Streaming Settings
DEFAULT_PROCESS_FPS=10  # Process N frames per second (5, 10, 15, 30)
MAX_FRAME_QUEUE_SIZE=30  # Maximum frames in processing queue
ENABLE_FRAME_SKIPPING=true  # Skip frames if processing is slow
